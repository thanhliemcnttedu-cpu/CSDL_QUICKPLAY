# Sao chép thành .env.local (máy) hoặc khai báo trong Vercel > Settings > Environment Variables.

# URL Web App Apps Script. Khi có giá trị này, lần đầu mở ứng dụng sẽ tự chọn chế độ "Google Drive".
VITE_SCRIPT_URL=

# Địa chỉ bản web công khai (VD: https://quizzi-ten-ban.vercel.app/). Bản cài .exe dùng địa chỉ này
# để tạo link/QR cho học sinh vào phòng, vì bản máy tính chạy từ file:// không có địa chỉ web.
VITE_PUBLIC_URL=

# Địa chỉ /exec của máy chủ tài khoản (apps-script-admin). Có giá trị này thì khu giáo viên bắt buộc đăng nhập.
VITE_ADMIN_URL=
